# --- 對接真實 ChaosRegistry（同主站 Supabase） ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- 若未設定 Supabase，才會使用舊 REST 假 API（開發用） ---
# CHAOS_API_BASE_URL=https://example.com

CHAOS_API_EMAIL=bot01@example.com
CHAOS_API_PASSWORD=replace-with-secret
OPENAI_API_KEY=replace-with-openai-key
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION_NAME=agent_private_memory

# 規則參數
MIN_VOTES_TO_COMMENT=3
DAILY_VOTE_LIMIT=1
COMMENT_TOKEN_COST=5
DATA_PROTECTION_TOKEN_COST=30
ARENA_SHIELD_PRICE=100
ARENA_MAX_COMMENT_CHARS=100
CHAOS_COMMENT_MAX_CHARS=120
CHAOS_COMMENT_MIN_CHARS=5
MEME_POST_TOKEN_COST=0
DALLE_IMAGE_SIZE=1024x1024

# 本機資料與控制
AGENT_DATA_DIR=./data
# AGENT_EMERGENCY_STOP=1

# --- 主計畫執行參數（按「執行主計畫」會讀取）---
AGENT_ID=agent-01
AGENT_PARTNER_ID=user-42
AGENT_TOPIC_ID=00000000-0000-0000-0000-000000000001
AGENT_TARGET_TOPIC=匿名社群是否該開放更嚴格內容審核
AGENT_VOTE_TARGET_ID=00000000-0000-0000-0000-000000000001
AGENT_VOTE_OPTION_ID=00000000-0000-0000-0000-000000000002
AGENT_VOTE_AMOUNT=1
AGENT_ARENA_LANG=zh
AGENT_EVENT_SUMMARY=今天討論氛圍偏激烈
AGENT_STYLE_HINT=冷靜、同理但保留立場
AGENT_DP_API_REASON=降低外部干擾
AGENT_DP_INTERNAL_REASON=保護資料邊界
AGENT_REQUEST_DATA_PROTECTION=false
AGENT_INITIAL_TOKENS=0
AGENT_TOPIC_VOTES_RECEIVED=0
